---
import { ProjectTag, tagColors, hexToRgba } from '../types/projectTags';
import '@fortawesome/fontawesome-free/css/fontawesome.css';
import '@fortawesome/fontawesome-free/css/solid.css';

function isOngoing(endDate: Date) {
	return endDate.getFullYear() === 9999;
}

function getProjectDuration(startDate: Date, endDate: Date): string {
	if (isOngoing(endDate)) {
		return 'Ongoing';
	}

	const days = Math.round((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24));
	const weeks = Math.round(days / 7);
	const months = Math.round(days / 30);

	if (months >= 1) {
		return `${months} month${months > 1 ? 's' : ''}`;
	} else if (Math.floor(days / 7) >= 1) {
		return `${weeks} week${weeks > 1 ? 's' : ''}`;
	} else if (days >= 1) {
		return `${days} day${days > 1 ? 's' : ''}`;
	} else {
		return 'Less than a day';
	}
}

interface Props {
	backgroundImage: string;
	title: string;
	creationDate: Date;
	finishDate: Date;
	shortDescription: string;
	longDescription: string;
	tags: (ProjectTag | string)[];
	socialMediaLink: string;
	aspectRatio?: string;
}

const {
	backgroundImage,
	title,
	creationDate,
	finishDate,
	shortDescription,
	longDescription,
	tags,
	socialMediaLink,
	aspectRatio = 'default',
} = Astro.props;


---

<a target="_blank" href={socialMediaLink} class={`project-card${isOngoing(finishDate) ? ' highlighted-project' : ''}`} style={`${aspectRatio === 'default' ? '' : ('aspect-ratio: ' + aspectRatio + ';')}`}>
	<div class="project-background" style={`background-image: url(${backgroundImage})`}></div>

	<div class="project-content">
		<div class="project-copy">
			<div class="project-header">
				<h3 class="project-title">{title}</h3>
				<span class="project-duration"><span class="fa-solid fa-clock"></span> {getProjectDuration(creationDate, finishDate)}</span>
			</div>

			<p class="project-description project-description-short">{shortDescription} </p>
			{
			longDescription.split('\n').map(line => (
				<p class="project-description project-description-long">{line}</p>
			))
			}
			
		</div>

		<div class="project-tags">
			{
				tags.map(tag => {
					const base = tagColors[tag] || tagColors[tag as ProjectTag] || '#c0c0c0';
					return (
						<span 
							class="tag" 
							style={
								`background-color: ${hexToRgba(base, 0.3)}; 
								color: ${hexToRgba(base, 1)}; 
								border-color: ${hexToRgba(base, 1)};
							`}>
							{tag}
						</span>
					);
				})
			}
		</div>
	</div>

	<i class="fa-solid fa-link link-icon"></i>
</a>

<style>
	.project-card {
		display: block;
		position: relative;
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		cursor: pointer;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		box-shadow: var(--box-shadow);
		margin-bottom: 2rem;
		aspect-ratio: 14 / 9;
	}

	.link-icon {
		position: absolute;
		bottom: 0.6rem;
		right: 0.6rem;
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.8);
		z-index: 2;
		background: rgba(0, 0, 0, 0.3);
		padding: 0.5rem 1rem 1rem 0.5rem;
		border-radius: 8px 0 0 0;
		margin: -0.5rem -1rem -1rem -0.5rem;
		overflow: hidden;
	}

	.highlighted-project {
		border: 4px solid var(--accent);
        box-shadow: var(--box-shadow-accent);
	}

	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--box-shadow-accent);
	}

	.project-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0);
		transition: background 0.25s ease;
		z-index: 1;
	}

	.project-card:hover::before {
		background: rgba(0, 0, 0, 0.45);
	}

	.project-background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		z-index: 0;
		/* box-shadow: inset 0 0 40px 2px rgba(0, 0, 0, 0.4); */
		/* background: linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.25)); */
	}

	.project-background::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.37) 85%);
	}

	.project-content {
		position: absolute;
		inset: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		z-index: 2;
		color: white;
	}

	.project-copy {
		display: inline-flex;
		flex-direction: column;
		align-self: flex-start;
		gap: 0.5rem;
		min-width: 100%;
		padding: 0;
		background: rgba(0, 0, 0, 0.3);
		border-radius: 12px 12px 0 0;
		overflow: visible;
		backdrop-filter: blur(4px);
		transition: background-color 0.2s ease, border-radius 0.2s ease, flex 0.2s ease;
	}

	.project-copy > * {
		padding-left: 1rem;
		padding-right: 1rem;
	}

	.project-copy > .project-header {
		padding-top: 1rem;
	}

	.project-copy > .project-description {
		padding-bottom: 0.7rem;
	}

	.project-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 0;
	}

	.project-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		color: white;
		flex: 1;
		line-height: 1.2;
	}

	.project-duration {
		font-size: 1rem;
		color: var(--accent);
		font-weight: 600;
		white-space: nowrap;
	}

	.project-description {
		margin: 0;
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.9);
		overflow: hidden;
		line-height: 1.4;
	}

	.project-description-short {
		display: block;
		/* -webkit-line-clamp: 3;
		-webkit-box-orient: vertical; */
	}

	.project-description-long {
		display: none;
		/* -webkit-line-clamp: 5;
		-webkit-box-orient: vertical; */
	}

	.project-card:hover .project-copy {
		flex: 1 1 auto;
		background: rgba(0, 0, 0, 0.55);
		
	}

	.project-card:hover .project-description-short {
		/* display: none; */
	}

	.project-card:hover .project-description-long {
		display:block;
	}
    .project-card:hover .project-tags {
		display: none; 
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1rem;
		padding: 0;

		border-radius: 0 0 12px 12px;

		margin-top: auto;

	}

	.tag {
		display: inline-block;
		padding: 0.2rem 0.5rem;
		backdrop-filter: blur(4px);
		border-radius: 4px;
		font-size: 0.9rem;
		border: 1px solid;
		font-weight: 600;
		white-space: nowrap;
		letter-spacing: -0.02em;
		background: rgba(80, 80, 100, 0.4);
		color: rgba(255, 255, 255, 0.9);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	@media (max-width: 960px) {
		.project-card {
			aspect-ratio: 5 / 4;
		}

		.project-copy {
			max-width: 100%;
		}

		.project-copy > * {
			padding-left: 0.85rem;
			padding-right: 0.85rem;
		}

		.project-copy > .project-header {
			padding-top: 0.85rem;
		}

		.project-copy > .project-description {
			padding-bottom: 0.85rem;
		}

		.project-title {
			font-size: 1.25rem;
		}

		.project-description {
			font-size: 0.85rem;
		}

		.project-description-short {
			/* -webkit-line-clamp: 2; */
		}

		.project-description-long {
			/* -webkit-line-clamp: 4; */
		}

		.tag {
			font-size: 0.7rem;

		}
	}
</style>