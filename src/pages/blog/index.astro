---
import BaseHead from '../../components/BaseHead.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BlogPost from '../../components/BlogPost.astro';

type BlogEntry = (typeof posts)[number];

const posts = (await getCollection('blog')).sort(
	(a: BlogEntry, b: BlogEntry) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				min-height: 100vh;
                width: 100%;
                top: 0;
                left: 0;
                margin: 0;
                padding: 0;
				display: flex;
				flex-direction: column;
			}
			main {
				position: relative;
				width: min(1220px, calc(100% - 2rem));
				/* margin-inline: auto;
				padding-top: 4.5rem;
				padding-bottom: 4rem;
				display: flex;
				flex-direction: column;
                flex-wrap: nowrap;
				gap: 4rem;
				align-items: start;
				isolation: isolate; */
			}
			ul {
				display: flex;
				align-items: center;
				flex-direction: column;
				flex-wrap: nowrap;
				gap: 1rem;
				list-style-type: none;

				padding: 0;
			}

			@media (max-width: 1000px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li a {
					flex-direction: column;
					align-items: center;
				}
			}
		</style>
	</head>
	<body>
		<Navbar />
		<main>
			<h2 style="text-align: center;">Take your time.</h2>

			<ul>
				{
					posts.map((post: BlogEntry) => (
						<BlogPost
							backgroundImage={post.data.cover}
							title={post.data.title}
							published={post.data.published}
							shortDescription={post.data.description}
							tags={post.data.tags}
							href={`/blog/${post.slug}/`}
						/>
					))
				} 
			</ul>
		</main>
		
		<ScrollToTop/>
		<Footer/>
	</body>
</html>
