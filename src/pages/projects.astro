---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Project from '../components/Project.astro';
import { ProjectTag } from '../types/projectTags';	
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import ScrollToTop from '../components/ScrollToTop.astro';
import { getCollection } from 'astro:content';

function parseDate(date: Date) {
	if (date.getFullYear() === 9999) {
		return 'Present';
	}

	return date.toLocaleString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
}

function parsePeriod(a: Date, b: Date) {
	if (a.getFullYear() === b.getFullYear()) {
		return a.toLocaleString('en-US', { day: 'numeric', month: 'short' }) + ' - ' + b.toLocaleString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
	}
	return parseDate(a) + ' - ' + parseDate(b);
}

type ProjectEntry = (typeof projects)[number];

const projects = (await getCollection('projects')).sort(
	(a: ProjectEntry, b: ProjectEntry) => b.data.creationDate.valueOf() - a.data.creationDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				min-height: 100vh;
                width: 100%;
                top: 0;
                left: 0;
                margin: 0;
                padding: 0;
				display: flex;
				flex-direction: column;
			}
			main {
				width: min(1200px, calc(100% - 2rem));
				position: relative;
				margin: 0 auto;
				padding: 0 0 3rem;
			}

			section {
				width: 100%;
			}

			header {
				margin: 2rem 0 2.5rem;
			}

			h1 {
				margin: 0;
				font-size: clamp(2.5rem, 5vw, 4.5rem);
				line-height: 1;
			}

			p {
				margin: 0.75rem 0 0;
				max-width: 42rem;
				color: var(--alt-heading-color);
				font-size: 1.05rem;
			}

			ul {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				align-items: start;
				list-style-type: none;
				gap: 1.5rem;
				margin: 0;
				padding: 0;
			}

			ul li {
				min-width: 0;
			}

			.project-meta {
				margin: 0 0 0.75rem;
				font-size: 0.9rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--accent);
			}

			.project-meta span {
				color: var(--alt-heading-color);
			}

			.project-note {
				margin-top: 1.5rem;
				color: var(--alt-heading-color);
				font-style: italic;
				text-align: center;
			}
			@media (max-width: 960px) {
				main {
					width: min(100%, calc(100% - 1rem));
				}
			}
		</style>
	</head>
	<body>
		<Navbar />
		<main>
			<section>
				<header>
					<br>
					<h1>Projects</h1>
					<p>A chronological grid of what I have built, ordered from latest to earliest work.</p>
				</header>
				<ul>
					{
						projects.map((project: ProjectEntry) => (
							<li>
								<p class="project-meta">{parsePeriod(project.data.creationDate, project.data.finishDate)}</p>
								<Project
									backgroundImage={project.data.backgroundImage}
									title={project.data.title}
									creationDate={project.data.creationDate}
									finishDate={project.data.finishDate}
									shortDescription={project.data.shortDescription}
									longDescription={project.data.longDescription}
									tags={project.data.tags}
									socialMediaLink={project.data.socialMediaLink}
									aspectRatio={project.data.aspectRatio}
								/>
							</li>
						))
					}
				</ul>
				<p class="project-note">More projects are on the way.</p>
			</section>
		</main>

		<ScrollToTop/>
		<Footer />
	</body>
</html>
